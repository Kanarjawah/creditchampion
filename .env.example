NODE_ENV=development
PORT=3000
# Hostinger: NODE_ENV=production, NPM_CONFIG_INCLUDE=dev, entry dist/server.js.
# Leave private accounts disabled until an isolated staging PostgreSQL database,
# migration and secure secrets are configured. Never commit actual secrets.
# ACCOUNT_MODE=private_staging
# APP_ORIGIN=https://your-staging-host.example
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB
# DB_SSL=require
# DATA_ENCRYPTION_KEY=32_RANDOM_BYTES_BASE64
# STAGING_REGISTRATION_CODE=LONG_RANDOM_INVITATION_CODE
# No live credit ingestion, document uploads, tax filings or payments.
# Hostinger native MySQL is supported. Use 127.0.0.1 on the application host.
# DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE
# DB_MIGRATE_ON_START=true
# PUBLIC_AGENCY_TENANT_ID=ISOLATED_AGENCY_UUID
# Optional private ClamAV Unix socket; absent means uploads stay closed.
# CLAMD_SOCKET=/private/path/clamd.sock
# Optional Hostinger SMTP. Enter credentials only in Hostinger environment settings.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=YOUR_MAILBOX
# SMTP_PASSWORD=PRIVATE_MAILBOX_PASSWORD
# MAIL_FROM=YOUR_VERIFIED_SENDER
# MAIL_POSTAL_ADDRESS=YOUR_BUSINESS_POSTAL_ADDRESS
# EMAIL_WORKER_ENABLED=false
# Optional alternative sender: RESEND_API_KEY, with MAIL_FROM and MAIL_POSTAL_ADDRESS.
